// XP match: the shared files, the creature effect that summons the
// helper once the NPC has a level, and the XP match on join.
//
// The chain: opcode 272 on the NPC applies c5xpchk.eff once per round.
// Its opcode 326 casts c5xpgo.spl when the NPC matches the splprot.2da
// row "LEVEL >= 1". The spell removes the opcode 272 (opcode 321, by
// the parent resource tag) and summons c5xp.cre (opcode 67 through
// c5xpsum.eff), which runs c5xp.bcs: the ladder that raises the NPC's
// XP to the protagonist's.
//
// The XP match on join casts c5xpjoin.spl ahead of every JoinParty():
// one opcode 177 that applies c5xpchk.eff. A level 0 NPC gets nothing
// and its opcode 272 fires at the level-up. A leveled NPC gets c5xpgo.spl,
// whose opcode 321 now has nothing to remove.

//
// Adds the splprot.2da row, copies the helper creature, the effect files
// and the spell, and compiles the helper script with the ladder blocks.
//
// The ladder: for each chunk, 1,000,000 down to 100 in tenths, and each
// rung 1 to 99 times the chunk, one block: the protagonist has at least
// the rung and the NPC at most the rung minus the chunk, so add the
// chunk. Largest chunks first, rungs descending. Rungs above the game's
// XP cap never fire.
//
DEFINE_ACTION_FUNCTION c5_install_xp BEGIN
  // The row "stat LEVEL >= 1": 34 1 4. A row with these values from
  // an earlier run or another mod serves as well.
  COPY_EXISTING ~splprot.2da~ ~override~
    COUNT_2DA_ROWS 4 rows
    SET row = 0 - 1
    FOR (i = 0; i < rows; i += 1) BEGIN
      READ_2DA_ENTRY i 1 4 stat
      READ_2DA_ENTRY i 2 4 value
      READ_2DA_ENTRY i 3 4 relation
      PATCH_IF IS_AN_INT stat AND IS_AN_INT value AND IS_AN_INT relation BEGIN
        PATCH_IF (stat = 34) AND (value = 1) AND (relation = 4) BEGIN
          SET row = i
        END
      END
    END
    PATCH_IF (row < 0) BEGIN
      SET row = rows
      INSERT_2DA_ROW rows 4 ~%rows%_LEVEL>=1 34 1 4~
    END
  BUT_ONLY

  COPY ~%MOD_FOLDER%/resources/c5xpchk.eff~ ~override~
    WRITE_LONG 0x20 row                             // parameter 2: the row
  COPY ~%MOD_FOLDER%/resources/c5xpgo.spl~ ~override~
  COPY ~%MOD_FOLDER%/resources/c5xpsum.eff~ ~override~
  COPY ~%MOD_FOLDER%/resources/c5xp.cre~ ~override~

  OUTER_SPRINT c5_ladder ~~
  OUTER_FOR (chunk = 1000000; chunk >= 100; chunk = chunk / 10) BEGIN
    OUTER_FOR (i = 99; i >= 1; i -= 1) BEGIN
      OUTER_SET rung = i * chunk
      ACTION_IF (rung <= 8000000) BEGIN               // the BG2:EE XP cap
        OUTER_SET above = rung - 1
        OUTER_SET below = rung - chunk + 1
        OUTER_SPRINT c5_ladder ~%c5_ladder%IF%LNL%~
        OUTER_SPRINT c5_ladder ~%c5_ladder%  XPGT(Protagonist,%above%)%LNL%~
        OUTER_SPRINT c5_ladder ~%c5_ladder%  XPLT(LastSummonerOf(Myself),%below%)%LNL%~
        OUTER_SPRINT c5_ladder ~%c5_ladder%THEN%LNL%~
        OUTER_SPRINT c5_ladder ~%c5_ladder%  RESPONSE #100%LNL%~
        OUTER_SPRINT c5_ladder ~%c5_ladder%    IncrementGlobal("c5_rounds","LOCALS",1)%LNL%~
        OUTER_SPRINT c5_ladder ~%c5_ladder%    AddXPObject(LastSummonerOf(Myself),%chunk%)%LNL%~
        OUTER_SPRINT c5_ladder ~%c5_ladder%END%LNL%%LNL%~
      END
    END
  END
  COMPILE EVALUATE_BUFFER ~%MOD_FOLDER%/scripts/c5xp.baf~ USING ~%MOD_FOLDER%/lang/%s/setup.tra~
END

//
// Adds the opcode 272 that applies c5xpchk.eff once per round, once.
// The file gets V2 effects: they carry the parent resource tag that
// c5xpgo.spl removes the effect by.
//
DEFINE_PATCH_FUNCTION c5_add_xp_effect BEGIN
  LPF FJ_CRE_EFF_V2 END
  LPF DELETE_EFFECT INT_VAR match_opcode = 272 STR_VAR match_resource = ~c5xpchk~ END
  LPF ADD_CRE_EFFECT
    INT_VAR opcode = 272 target = 1 timing = 9 parameter1 = 6 parameter2 = 3 parameter4 = 1 restype = 1
    STR_VAR resource = ~c5xpchk~ effsource = ~C5XPGO~
  END
END

//
// Turns off the join XP of the NPC's files. Every joinable's override
// script has blocks that set its XP to a tier when it joins.
//
// Input:
//     cres  the NPC's resrefs without .cre, separated by spaces
//
DEFINE_ACTION_FUNCTION c5_disable_joinxp
  STR_VAR cres = ~~
BEGIN
  OUTER_SET listed_count = 0
  OUTER_PATCH ~%cres%~ BEGIN
    REPLACE_EVALUATE ~\([^ %TAB%%LNL%%WNL%]+\)~ BEGIN
      SPRINT $listed(~%listed_count%~) ~%MATCH1%~
      SET listed_count += 1
    END ~~
  END

  OUTER_FOR (i = 0; i < listed_count; i += 1) BEGIN
    OUTER_SPRINT resref $listed(~%i%~)
    ACTION_IF FILE_EXISTS_IN_GAME ~%resref%.cre~ BEGIN
      OUTER_SPRINT script ~~
      COPY_EXISTING - ~%resref%.cre~ ~override~
        READ_ASCII 0x248 script (8) NULL // the override script

      ACTION_TO_LOWER script
      ACTION_IF NOT (~%script%~ STR_EQ ~~) AND NOT (~%script%~ STR_EQ ~none~)
                AND NOT VARIABLE_IS_SET $c5_joinxp_done(~%script%~)
                AND FILE_EXISTS_IN_GAME ~%script%.bcs~ BEGIN
        OUTER_SET $c5_joinxp_done(~%script%~) = 1
        OUTER_SET blocked = 0

        // Idempotency check – if the block's already there, we no-op out.
        COPY_EXISTING - ~%script%.bcs~ ~override~
          DECOMPILE_AND_PATCH BEGIN
            SET blocked = (INDEX_BUFFER (~Global("BD_JOINXP","LOCALS",0)[ %TAB%%LNL%%WNL%]*InParty(Myself)[ %TAB%%LNL%%WNL%]*THEN~) >= 0)
          END
        ACTION_IF NOT blocked BEGIN
          EXTEND_TOP ~%script%.bcs~ ~%MOD_FOLDER%/scripts/c5_joinxp.baf~
        END
      END
    END
  END
END

//
// Enables the XP match on join for every joinable, and disables
// the pre-existing XP-on-join features off for every joinable.
//
// Input:
//     again  when set to 1, patches the rejoin dialogues and scripts too
//
DEFINE_ACTION_FUNCTION c5_xp_on_join
  INT_VAR again = 0
BEGIN
  COPY ~%MOD_FOLDER%/resources/c5xpjoin.spl~ ~override~

  ACTION_IF GAME_IS ~bgee eet~ BEGIN
    LAF c5_patch_join_files INT_VAR again = again STR_VAR game = ~bg1~ END
  END
  ACTION_IF GAME_INCLUDES ~sod~ BEGIN
    LAF c5_patch_join_files INT_VAR again = again STR_VAR game = ~sod~ END
  END
  ACTION_IF GAME_IS ~bg2ee eet~ BEGIN
    LAF c5_patch_join_files INT_VAR again = again STR_VAR game = ~bg2~ END
  END

  OUTER_SET npcs_count = 0
  OUTER_PATCH ~%c5_joinables%~ BEGIN
    REPLACE_EVALUATE ~\([^ %TAB%%LNL%%WNL%]+\)~ BEGIN
      SPRINT $npcs(~%npcs_count%~) ~%MATCH1%~
      SET npcs_count += 1
    END ~~
  END

  OUTER_FOR (i = 0; i < npcs_count; i += 1) BEGIN
    OUTER_SPRINT npc $npcs(~%i%~)
    LAF c5_npc_files STR_VAR npc = EVAL ~%npc%~ RET cres END
    LAF c5_disable_joinxp STR_VAR cres = EVAL ~%cres%~ END
    LAF c5_mods_joinxp STR_VAR cres = EVAL ~%cres%~ END
  END
END

//
// Puts the join spell ahead of every JoinParty() of one game's join
// dialogues and scripts.
//
// Input:
//     game   bg1, sod or bg2
//     again  when set to 1, takes the rejoin list too
//
DEFINE_ACTION_FUNCTION c5_patch_join_files
  INT_VAR again = 0
  STR_VAR game = ~~
BEGIN
  OUTER_SPRINT listed $c5_joins(~%game%~)
  ACTION_IF again BEGIN
    OUTER_SPRINT rejoins $c5_rejoins(~%game%~)
    OUTER_SPRINT listed ~%listed% %rejoins%~
  END

  OUTER_SET entries_count = 0
  OUTER_PATCH ~%listed%~ BEGIN
    REPLACE_EVALUATE ~\([^ %TAB%%LNL%%WNL%.]+\)\.\([a-z]+\)~ BEGIN
      SPRINT $entry_names(~%entries_count%~) ~%MATCH1%~
      SPRINT $entry_exts(~%entries_count%~) ~%MATCH2%~
      SET entries_count += 1
    END ~~
  END

  OUTER_FOR (i = 0; i < entries_count; i += 1) BEGIN
    OUTER_SPRINT name $entry_names(~%i%~)
    OUTER_SPRINT ext $entry_exts(~%i%~)
    LAF c5_patch_join_file STR_VAR name = EVAL ~%name%~ ext = EVAL ~%ext%~ END
    ACTION_IF GAME_IS ~eet~ AND NOT (~%game%~ STR_EQ ~bg2~) BEGIN
      LAF c5_patch_join_file STR_VAR name = EVAL ~%name%_~ ext = EVAL ~%ext%~ END
    END
  END
END

//
// Puts the join spell ahead of every JoinParty() of one dialogue or
// script, if present.
//
// Input:
//     name  the resref
//     ext   dlg or bcs
//
DEFINE_ACTION_FUNCTION c5_patch_join_file
  STR_VAR name = ~~ ext = ~~
BEGIN
  ACTION_IF FILE_EXISTS_IN_GAME ~%name%.%ext%~ BEGIN
    ACTION_IF (~%ext%~ STR_EQ ~dlg~) BEGIN
      COPY_EXISTING ~%name%.dlg~ ~override~
        DECOMPILE_DLG_TO_D
          LPF c5_append_join_casts END
        COMPILE_D_TO_DLG
      BUT_ONLY
    END ELSE BEGIN
      COPY_EXISTING ~%name%.bcs~ ~override~
        DECOMPILE_BCS_TO_BAF
          LPF c5_append_join_casts END
        COMPILE_BAF_TO_BCS
      BUT_ONLY
    END
  END
END

//
// Puts ReallyForceSpellRes("c5xpjoin",Myself) ahead of every
// JoinParty() and JoinPartyOverride() in the dialogue or script source
// in the buffer, source has one already.
//
DEFINE_PATCH_FUNCTION c5_append_join_casts BEGIN
  PATCH_IF (INDEX_BUFFER (~c5xpjoin~) < 0) BEGIN
    REPLACE_TEXTUALLY ~\([^,a-zA-Z0-9_]\)JoinParty\(Override\|\)()~ ~\1ReallyForceSpellRes("c5xpjoin",Myself) JoinParty\2()~
    REPLACE_TEXTUALLY ~ActionOverride(\([^,]+\),JoinParty\(Override\|\)())~ ~ActionOverride(\1,ReallyForceSpellRes("c5xpjoin",Myself)) ActionOverride(\1,JoinParty\2())~
  END
END
