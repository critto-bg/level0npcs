// The joinables. The creature files of every stock joinable per game,
// and the dialogues and scripts that join one to the party, per game.

// Every joinable, the NPC components' order. Wilson has no component.
OUTER_SPRINT c5_joinables ~aerie ajantis alora anomen baeloth branwen cernd
                           coran corwin dorn dynaheir edwin eldoth faldorn
                           garrick glint haerdalis hexxat imoen jaheira jan
                           kagain keldorn khalid kivan korgan mazzy minsc
                           mkhiin montaron nalia neera quayle rasaad safana
                           sarevok sharteel skie tiax valygar viconia
                           voghiln xan xzar yeslick yoshimo wilson~

// The creature files without .cre, per key and game: bg1 for BG:EE and
// EET, sod when the game includes SoD, bg2 for BG2:EE and EET.
ACTION_DEFINE_ASSOCIATIVE_ARRAY c5_cres BEGIN
  ~aerie~,     ~bg2~ => ~aerie6 aerie7 aerie9 aerie10 aerie11 aerie12~
  ~ajantis~,   ~bg1~ => ~ajanti ajanti4 ajanti6~
  ~alora~,     ~bg1~ => ~alora alora6~
  ~anomen~,    ~bg2~ => ~anomen6 anomen7 anomen8 anomen9 anomen10 anomen12~
  ~baeloth~,   ~bg1~ => ~baeloth~
  ~baeloth~,   ~sod~ => ~baelot7~
