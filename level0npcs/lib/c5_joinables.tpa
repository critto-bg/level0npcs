  ~korgan~,    ~bg2~ => ~korgan8 korgan9 korgan11 korgan12 korgan15~
  ~mazzy~,     ~bg2~ => ~mazzy8 mazzy9 mazzy11 mazzy12 mazzy15~
  ~minsc~,     ~bg1~ => ~minsc minsc2 minsc4 minsc6~
  ~minsc~,     ~sod~ => ~minsc7~
