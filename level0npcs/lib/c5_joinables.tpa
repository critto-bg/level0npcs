// The dialogues and scripts with a JoinParty() of a joinable, per game.
//
// c5_joins has the first join: the NPC's own dialogue, the ToB meeting
// (25a), the cutscene scripts.
ACTION_DEFINE_ASSOCIATIVE_ARRAY c5_joins BEGIN
  ~bg1~ => ~ajanti.dlg alora.dlg baeloth.dlg branwe.dlg coran.dlg dorn.dlg
           dynahe.dlg edwin.dlg edwinj.dlg eldoth.dlg faldor.dlg garric.dlg
           imoen2.dlg jaheir.dlg kagain.dlg kivan.dlg minsc.dlg montar.dlg
           neera.dlg quayle.dlg rasaad.dlg safana.dlg sharte.dlg skie.dlg
           tiax.dlg viconi.dlg xan.dlg xzar.dlg yeslic.dlg~

  ~sod~ => ~bdajanti.dlg bdalora.dlg bdbaelot.dlg bdbranwe.dlg bdcoran.dlg
           bdcorwin.dlg bddorn.dlg bddynahe.dlg bdedwin.dlg bdeldoth.dlg
           bdfaldor.dlg bdgarric.dlg bdglint.dlg bdimoen.dlg bdjaheir.dlg
           bdkagain.dlg bdkhalid.dlg bdkhalij.dlg bdkivan.dlg bdminsc.dlg
           bdminscj.dlg bdmkhiin.dlg bdmontar.dlg bdneera.dlg bdquayle.dlg
           bdrasaad.dlg bdsafana.dlg bdsharte.dlg bdskie.dlg bdtiax.dlg
           bdviconi.dlg bdvoghil.dlg bdvoghij.dlg bdxan.dlg bdxzar.dlg
           khalij.dlg minscj.dlg bdcut64x.bcs bdintro.bcs~

  ~bg2~ => ~aerie.dlg aerie25a.dlg anomen.dlg anome25a.dlg cernd.dlg
           cernd25a.dlg dorn.dlg dorn25a.dlg edwin.dlg edwin25a.dlg
           haerda.dlg haerd25a.dlg hexxat.dlg hexxa25a.dlg imoen2.dlg
           imoen10.dlg imoen25a.dlg jaheira.dlg jahei25a.dlg jan.dlg
           jan25a.dlg keldor.dlg keldo25a.dlg korgana.dlg korga25a.dlg
           mazzy.dlg mazzy25a.dlg minsca.dlg minsc25a.dlg nalia.dlg
           nalia25a.dlg neera.dlg neera25a.dlg quayle.dlg rasaad.dlg
           rasaa25a.dlg sarev25a.dlg valygar.dlg valyg25a.dlg viconi.dlg
           vicon25a.dlg wilson.dlg yoshimo.dlg minsc.bcs~
END

// c5_rejoins has the dialogue after kick-out (p), the in-party dialogues (j)
// and the scripts that bring a quest NPC back.
// A SoD dialogue serves the first join and the rejoin alike, so the sod
// rejoin list is empty.
ACTION_DEFINE_ASSOCIATIVE_ARRAY c5_rejoins BEGIN
  ~bg1~ => ~ajantp.dlg alorap.dlg baelothp.dlg branwp.dlg coranp.dlg
           dornj.dlg dornp.dlg dynahj.dlg dynahp.dlg edwinp.dlg eldotp.dlg
           faldop.dlg garrip.dlg imoenp.dlg jaheip.dlg kagaip.dlg khalip.dlg
           kivanp.dlg minscp.dlg montap.dlg neerap.dlg quaylp.dlg
           rasaadp.dlg safanp.dlg shartp.dlg skiep.dlg tiaxp.dlg viconp.dlg
           xanp.dlg xzarp.dlg yeslip.dlg~
  ~sod~ => ~~
  ~bg2~ => ~aeriep.dlg aerie25p.dlg anomenj.dlg anomenp.dlg banomen.dlg
           anome25p.dlg cerndp.dlg cernd25p.dlg dornp.dlg dorn25p.dlg
           edwinp.dlg edwin25p.dlg haerdap.dlg haerd25p.dlg hexxatp.dlg
           hexxa25p.dlg imoen2p.dlg imoen25p.dlg jaheirap.dlg jahei25p.dlg
           janp.dlg jan25p.dlg keldorp.dlg keldo25p.dlg korganp.dlg
           korga25p.dlg mazzyp.dlg mazzy25p.dlg minscp.dlg minsc25p.dlg
           naliap.dlg nalia25p.dlg neeraj.dlg neerap.dlg neera25p.dlg
           rasaadp.dlg rasaa25j.dlg rasaa25p.dlg sarev25j.dlg sarev25p.dlg
           valygarp.dlg valyg25p.dlg viconip.dlg vicon25p.dlg wilsonp.dlg
           yoshp.dlg ar0800.bcs cut11a.bcs hexxat.bcs hexxa25.bcs ohdano.bcs
           ohdano2.bcs ohhaeri.bcs ohhaeri2.bcs ohhkeld.bcs ohhkeld2.bcs
           ohhmaz.bcs ohhmaz2.bcs ohhval.bcs ohhval2.bcs~
END
