BACKUP ~level0npcs/backup~
AUTHOR ~critto~
VERSION ~1.0.0~ // x-release-please-version
README ~level0npcs/readme.html~

NO_IF_EVAL_BUG
ASK_EVERY_COMPONENT

ALWAYS
  SILENT

  ACTION_IF (~%WEIDU_OS%~ STR_EQ ~win32~) BEGIN
    OUTER_TEXT_SPRINT c5_nl ~%WNL%~
  END ELSE BEGIN
    OUTER_TEXT_SPRINT c5_nl ~%LNL%~
  END

  INCLUDE ~%MOD_FOLDER%/lib/c5_2da.tpa~
  INCLUDE ~%MOD_FOLDER%/lib/c5_menu.tpa~
  INCLUDE ~%MOD_FOLDER%/lib/c5_chargen.tpa~
  INCLUDE ~%MOD_FOLDER%/lib/c5_spellbook.tpa~
  INCLUDE ~%MOD_FOLDER%/lib/c5_items.tpa~
  INCLUDE ~%MOD_FOLDER%/lib/c5_xp.tpa~
  INCLUDE ~%MOD_FOLDER%/lib/c5_npc.tpa~

  LAM c5_load_tables
  LAM c5_load_spells
END

LANGUAGE ~English~ ~english~ ~level0npcs/lang/english/setup.tra~

// Shared files, every NPC component requires it. //

BEGIN @1
LABEL ~C5-LEVEL0NPCS-SHARED~
DESIGNATED 0
REQUIRE_PREDICATE GAME_IS ~bgee bg2ee eet~ @10

LAF c5_install_xp END

// Aerie //

BEGIN @100
LABEL ~C5-LEVEL0NPCS-AERIE~
DESIGNATED 100
GROUP @4 (GAME_IS ~bg2ee eet~)
REQUIRE_PREDICATE GAME_IS ~bg2ee eet~ @16
REQUIRE_COMPONENT ~level0npcs/setup-level0npcs.tp2~ 0 @13

OUTER_SPRINT c5_npc @100
LAF c5_update_npc
  STR_VAR
    bg2 = ~aerie6 aerie7 aerie9 aerie10 aerie11 aerie12~
  RET c5_avatar = avatar
END
LAF c5_aerie_true_form STR_VAR avatar = EVAL ~%c5_avatar%~ END
LAF c5_aerie_circus END
LAF c5_hurt_banter STR_VAR object = ~"Aerie"~ hp = ~10~ END

