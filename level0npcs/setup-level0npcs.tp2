GROUP @3 (GAME_INCLUDES ~sod~)
REQUIRE_PREDICATE GAME_INCLUDES ~sod~ @17
REQUIRE_COMPONENT ~level0npcs/setup-level0npcs.tp2~ 0 @13

OUTER_SPRINT c5_npc @141
LAF c5_update_npc
  STR_VAR
    sod = ~voghil7~
    kit_effects = ~73 278 251~
END

