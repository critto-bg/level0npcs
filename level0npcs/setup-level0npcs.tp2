GROUP @2 (GAME_IS ~bgee eet~)
REQUIRE_PREDICATE GAME_IS ~bgee eet~ @15
REQUIRE_COMPONENT ~level0npcs/setup-level0npcs.tp2~ 0 @13

OUTER_SPRINT c5_npc @143
LAF c5_update_npc
  STR_VAR
    npc = ~xzar~
END

