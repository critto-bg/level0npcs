// XP match on join //

BEGIN @7
LABEL ~C5-LEVEL0NPCS-XPJOIN-FIRST~
SUBCOMPONENT @6
GROUP @9 (GAME_IS ~bgee bg2ee eet~)
DESIGNATED 1
REQUIRE_PREDICATE GAME_IS ~bgee bg2ee eet~ @10
REQUIRE_COMPONENT ~level0npcs/setup-level0npcs.tp2~ 0 @13

LAF c5_xp_on_join END

BEGIN @8
LABEL ~C5-LEVEL0NPCS-XPJOIN-EVERY~
SUBCOMPONENT @6
GROUP @9 (GAME_IS ~bgee bg2ee eet~)
DESIGNATED 2
REQUIRE_PREDICATE GAME_IS ~bgee bg2ee eet~ @10
REQUIRE_COMPONENT ~level0npcs/setup-level0npcs.tp2~ 0 @13

LAF c5_xp_on_join INT_VAR again = 1 END

