    bg2 = ~valyg8 valyg9 valyg11 valyg12 valyg14~
    personal = ~npsw04 npchan~
END

// Viconia //

BEGIN @140
LABEL ~C5-LEVEL0NPCS-VICONIA~
DESIGNATED 140
GROUP @2 (GAME_IS ~bgee eet~)
GROUP @3 (GAME_INCLUDES ~sod~)
GROUP @4 (GAME_IS ~bg2ee eet~)
REQUIRE_PREDICATE GAME_IS ~bgee bg2ee eet~ @10
REQUIRE_COMPONENT ~level0npcs/setup-level0npcs.tp2~ 0 @13

OUTER_SPRINT c5_npc @140
LAF c5_update_npc
  STR_VAR
    bg1 = ~viconi viconi4 viconi6~
    sod = ~viconi7~
    bg2 = ~viconi6 viconi8 viconi9 viconi11 viconi13 viconi16~
  RET chosen_class chosen_kitids
END
LAF c5_sod_intro_gear INT_VAR class_id = chosen_class kitids = chosen_kitids STR_VAR name = ~viconia~ item = ~ring22~ END
LAF c5_viconia_protect END

// Voghiln //

BEGIN @141
LABEL ~C5-LEVEL0NPCS-VOGHILN~
