@200 = ~%c5_npc% is now: %c5_current%~
@201 = ~Choose a class for %c5_npc%. Enter the number and press Enter. Enter 0 to leave %c5_npc% as is.~
@202 = ~Choose a kit for %c5_npc% (%c5_class_name%). Enter the number and press Enter. Enter 0 to go back to the class list.~
@203 = ~%c5_class_name% (no kit)~
@204 = ~Enter a number from the list.~
@205 = ~No change made to %c5_npc%.~
@206 = ~%c5_npc% starts over as: %c5_chosen_text%.~
@207 = ~Choose a racial enemy for %c5_npc% (%c5_class_name%). Enter the number and press Enter. Enter 0 to go back to the ability scores.~
@208 = ~%c5_class_kit%, racial enemy %c5_enemy_name%~
@209 = ~%c5_npc% has %c5_scores_text%.%c5_nl%Enter six new ability scores from 3 to 25 in that order, separated by spaces, and press Enter.%c5_nl%Press Enter alone to keep the scores. Enter 0 to go back to the kit list.~
@210 = ~Enter six numbers from 3 to 25, separated by spaces.~
@211 = ~Enter the exceptional strength percentage, from 1 to 100, and press Enter. Enter 0 to go back to the ability scores.~
@212 = ~Enter a number from 1 to 100.~
@213 = ~STR %c5_score_str%, DEX %c5_score_dex%, CON %c5_score_con%, INT %c5_score_int%, WIS %c5_score_wis%, CHA %c5_score_cha%~
@214 = ~Ability scores: %c5_chosen_scores_text%.~
@215 = ~Choose a thief skill for %c5_npc% (%c5_class_name%). Each pick adds 5 points, %c5_skill_points_left% left to place.%c5_nl%The game adds the race and Dexterity bonuses, and %c5_skill_level_points% more points at the first level-up.%c5_nl%Enter the number and press Enter. Enter 0 to go back.~
@216 = ~%c5_skill_name% %c5_skill_value%~
@217 = ~Thief skills: %c5_chosen_skills_text%.~

